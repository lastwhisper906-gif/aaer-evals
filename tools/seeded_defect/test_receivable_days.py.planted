"""Days of revenue in receivables, over the three period ends in the table.

The expected numbers live in `tests/fixtures/receivable_days.json`. Regenerate
them whenever the reader changes:

    python3.12 -m src.receivable_days tests/fixtures/receivable_days.json
"""

from __future__ import annotations

import json
from pathlib import Path

from src import receivable_days

EXPECTED = Path(__file__).parent / "fixtures" / "receivable_days.json"


def test_receivable_days_over_the_three_period_ends() -> None:
    expected = json.loads(EXPECTED.read_text(encoding="utf-8"))
    assert receivable_days.over(receivable_days.PERIODS) == expected
